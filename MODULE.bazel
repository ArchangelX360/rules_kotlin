module(
    name = "rules_kotlin",
    version = "2.2.0",
    compatibility_level = 1,
    repo_name = "rules_kotlin",
)

proto_version = "4.33.4"

proto_version_parts = proto_version.split(".")

proto_module_version = ".".join(proto_version_parts[-2:])  # Last 2 parts

bazel_dep(name = "protobuf", version = proto_module_version, repo_name = "com_google_protobuf")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_java", version = "8.9.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_android", version = "0.8.0")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

bazel_dep(name = "hermetic_android_toolchains", version = "0.5.0", dev_dependency = True)

android = use_extension("@hermetic_android_toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "35.0.0",
    version = "35",
)
use_repo(android, "androidsdk")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
    dev_dependency = True,
)

override_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains(
    "@androidsdk//:all",
    dev_dependency = True,
)

bazel_dep(name = "bazel_features", version = "1.50.0")
bazel_dep(name = "bazel_lib", version = "3.1.0")
bazel_dep(name = "rules_shell", version = "0.4.1")
bazel_dep(name = "bazel_worker_api", version = "0.0.11")
bazel_dep(name = "bazel_worker_java", version = "0.0.11")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "rules_multirun", version = "0.14.0", dev_dependency = True)

rules_java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(rules_java_toolchains, "remote_java_tools")

rules_kotlin_extensions = use_extension("//src/main/starlark/core/repositories:bzlmod_setup.bzl", "rules_kotlin_extensions")
use_repo(
    rules_kotlin_extensions,
    "binaryen_aarch64-linux",
    "binaryen_arm64-macos",
    "binaryen_arm64-windows",
    "binaryen_x86_64-linux",
    "binaryen_x86_64-macos",
    "binaryen_x86_64-windows",
    "btapi_impl",
    "chromium_headless_shell_aarch64-linux",
    "chromium_headless_shell_arm64-macos",
    "chromium_headless_shell_x86_64-linux",
    "chromium_headless_shell_x86_64-macos",
    "chromium_headless_shell_x86_64-windows",
    "com_github_google_ksp",
    "com_github_jetbrains_kotlin",
    "com_github_jetbrains_kotlin_git",
    "com_github_pinterest_ktlint",
    "jarjar",
    "kotlin_build_tools_api",
    "kotlin_test_wasm_js",
    "kotlinx_coroutines_core_jvm",
    "kotlinx_serialization_core_jvm",
    "kotlinx_serialization_json",
    "kotlinx_serialization_json_jvm",
    "wasmjs_kotlin_web_helpers",
    "wasmjs_mocha",
)

register_toolchains("//src/main/starlark/core/compile:cli_toolchain")

register_toolchains("//kotlin:default_toolchain")

register_toolchains("//kotlin/internal/wasmjs/toolchains:all")

# Development dependencies
# TODO(bencodes) A bunch of these dependencies need to be marked as dev_dependencies but before we can do that
# we need to sort out a few cases around how these rules are consumed in various ways.

bazel_dep(name = "rules_jvm_external", version = "7.1")

bazel_dep(name = "bazel_ci_rules", version = "2.1.2", dev_dependency = True)

rbe = use_extension("@bazel_ci_rules//:rbe_config.bzl", "rbe_config_extension", dev_dependency = True)
rbe.config(
    name = "buildkite_config",
    preset = "ubuntu",
)
use_repo(rbe, "buildkite_config")

MAVEN_REPOSITORIES = [
    "https://maven-central.storage.googleapis.com/repos/central/data/",
    "https://maven.google.com",
    "https://repo1.maven.org/maven2",
]

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "kotlin_rules_maven",
    artifacts = [
        "com.google.code.findbugs:jsr305:3.0.2",
        "com.google.errorprone:error_prone_annotations:2.23.0",
        "com.google.guava:guava:33.0.0-jre",
        "com.google.auto.value:auto-value:1.11.0",
        "com.google.auto.value:auto-value-annotations:1.11.0",
        "org.apache.commons:commons-compress:1.26.2",
        "org.ow2.asm:asm:9.10.1",
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    lock_file = "//:kotlin_rules_maven_install.json",
    repositories = MAVEN_REPOSITORIES,
)
maven.override(
    name = "override_target_in_deps_kotlin_stdlib",
    coordinates = "org.jetbrains.kotlin.kotlin:kotlin-stdlib",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib",
)
maven.override(
    name = "override_target_in_deps_kotlin_stdlib_jdk7",
    coordinates = "org.jetbrains.kotlin.kotlin:kotlin-stdlib-jdk7",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib-jdk7",
)
maven.override(
    name = "override_target_in_deps_kotlin_stdlib_jdk8",
    coordinates = "org.jetbrains.kotlin.kotlin:kotlin-stdlib-jdk8",
    target = "@rules_kotlin//kotlin/compiler:kotlin-stdlib-jdk8",
)
use_repo(maven, "kotlin_rules_maven", "unpinned_kotlin_rules_maven")

# The runtime of kt_wasmjs_test, the browser test harness. The release archive ships the harness as
# one deploy jar, so the release module has no such install. serviceMessages is published on
# intellij-dependencies only.
maven.install(
    name = "kotlin_rules_wasmjs_harness_maven",
    artifacts = [
        "io.ktor:ktor-client-java-jvm:3.3.3",
        "org.hildan.chrome:chrome-devtools-kotlin-jvm:8.3.0-1589152",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm:1.10.2",
        # chrome-devtools-kotlin needs 1.10.0. ktor declares 1.9.0.
        "org.jetbrains.kotlinx:kotlinx-serialization-core-jvm:1.10.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-io-jvm:1.10.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-json-jvm:1.10.0",
        "org.jetbrains.teamcity:serviceMessages:2024.07",
        "org.slf4j:slf4j-nop:2.0.17",
    ],
    # The harness runs on the standard library of the compiler distribution.
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-reflect",
        "org.jetbrains.kotlin:kotlin-stdlib",
        "org.jetbrains.kotlin:kotlin-stdlib-common",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    lock_file = "//:kotlin_rules_wasmjs_harness_maven_install.json",
    repositories = MAVEN_REPOSITORIES + [
        "https://packages.jetbrains.team/maven/p/ij/intellij-dependencies",
    ],
    version_conflict_policy = "pinned",
)
use_repo(maven, "kotlin_rules_wasmjs_harness_maven", "unpinned_kotlin_rules_wasmjs_harness_maven")

# The npm packages and the klib of the kt_wasmjs_test end-to-end tests. The release module has none
# of them.
http_archive_dev = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file_dev = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# The kotlinx-datetime klib requests @js-joda/core 3.2.0. 5.7.0 is a newer, API-compatible version.
http_archive_dev(
    name = "wasmjs_e2e_js_joda_core",
    build_file = "//src/main/starlark/core/repositories:BUILD.npm.bazel",
    sha256 = "c603b2ca15a1304b9b5107019c5847a3f74a89873ac694589836959867ef9b90",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/@js-joda/core/-/core-5.7.0.tgz",
)

http_archive_dev(
    name = "wasmjs_e2e_nanoid",
    build_file = "//src/main/starlark/core/repositories:BUILD.npm.bazel",
    sha256 = "5cade80a39ccf4fd174c8e412eca13accfce36c9c2a0982b4ea23403d729a8d8",
    strip_prefix = "package",
    url = "https://registry.npmjs.org/nanoid/-/nanoid-6.0.0.tgz",
)

http_file_dev(
    name = "wasmjs_e2e_kotlinx_datetime_wasm_js",
    downloaded_file_path = "kotlinx-datetime-wasm-js-0.8.0.klib",
    sha256 = "5d84e1a3fb30f15337bf78259ca76ca4bba67a7690d9ae07da9bdbc75b88b5ed",
    url = "https://repo1.maven.org/maven2/org/jetbrains/kotlinx/kotlinx-datetime-wasm-js/0.8.0/kotlinx-datetime-wasm-js-0.8.0.klib",
)

# Artifacts used only by rules_kotlin's own tests, never by the builder or the released rules.
maven_test = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
maven_test.install(
    name = "kotlin_rules_maven_test",
    artifacts = [
        "junit:junit:4.13-beta-3",
        "com.google.truth:truth:0.45",
        "com.google.auto.service:auto-service:1.1.1",
        "com.google.auto.service:auto-service-annotations:1.1.1",
        "com.google.dagger:dagger:2.57.2",
        "com.google.dagger:dagger-compiler:2.57.2",
        "javax.inject:javax.inject:1",
        "dev.zacsweers.autoservice:auto-service-ksp:jar:1.2.0",
        "com.squareup.moshi:moshi:1.15.2",
        "com.squareup.moshi:moshi-kotlin:1.15.2",
        "com.squareup.moshi:moshi-kotlin-codegen:1.15.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.4.2",
    ],
    fail_if_repin_required = True,
    fetch_sources = True,
    lock_file = "//:kotlin_rules_maven_test_install.json",
    repositories = MAVEN_REPOSITORIES,
)
use_repo(maven_test, "kotlin_rules_maven_test", "unpinned_kotlin_rules_maven_test")

bazel_dep(name = "rules_pkg", version = "1.0.1")

bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True, repo_name = "io_bazel_stardoc")
bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)
bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1", dev_dependency = True)

bazel_binaries = use_extension("@rules_bazel_integration_test//:extensions.bzl", "bazel_binaries", dev_dependency = True)
bazel_binaries.download(version = "7.x")
bazel_binaries.download(version = "8.x")
bazel_binaries.download(version_file = "//:.bazelversion")
use_repo(
    bazel_binaries,
    "bazel_binaries",
    "bazel_binaries_bazelisk",
    "build_bazel_bazel_.bazelversion",
    "build_bazel_bazel_7_x",
    "build_bazel_bazel_8_x",
)
