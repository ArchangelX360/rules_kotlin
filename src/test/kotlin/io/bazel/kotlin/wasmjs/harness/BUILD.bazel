load("//kotlin:jvm.bzl", "kt_jvm_test")

kt_jvm_test(
    name = "harness_tests",
    size = "small",
    srcs = glob(["**/*.kt"]),
    associates = ["//src/main/kotlin/io/bazel/kotlin/wasmjs/harness:harness_lib"],
    kotlinc_opts = "//src/main/kotlin/io/bazel/kotlin/wasmjs/harness:harness_kotlinc_options",
    # The expected-output fixtures, on the classpath next to the test class that reads them.
    resource_strip_prefix = "src/test/kotlin",
    resources = glob(["**/fixtures/*"]),
    test_class = "io.bazel.kotlin.wasmjs.harness.AllTests",
    deps = [
        "@kotlin_rules_maven_test//:junit_junit",
        "@kotlin_rules_wasmjs_harness_maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core_jvm",
        "@kotlin_rules_wasmjs_harness_maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@kotlin_rules_wasmjs_harness_maven//:org_jetbrains_kotlinx_kotlinx_serialization_json_jvm",
    ],
)
