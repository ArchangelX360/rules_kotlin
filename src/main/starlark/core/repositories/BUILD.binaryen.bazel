# Build file of a binaryen release archive.
filegroup(
    name = "wasm-opt",
    srcs = glob(
        [
            "bin/wasm-opt",
            "bin/wasm-opt.exe",
            # The macOS wasm-opt links dynamically against the libbinaryen.dylib next to it.
            "bin/libbinaryen.dylib",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
