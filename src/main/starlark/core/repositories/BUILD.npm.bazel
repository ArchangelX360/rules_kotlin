# Build file of an npm package archive from registry.npmjs.org, extracted with
# strip_prefix = "package". kt_wasmjs_test serves `package` under /node_modules/<specifier>/, and
# reads its package.json to resolve the import map entry.
filegroup(
    name = "package",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD.bazel",
            "MODULE.bazel",
            "WORKSPACE",
        ],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "package_json",
    srcs = ["package.json"],
    visibility = ["//visibility:public"],
)
